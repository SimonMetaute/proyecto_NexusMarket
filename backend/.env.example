# NexusMarket backend environment configuration.
# Copy to `.env` (or export these variables) before running the service.
# Never commit real secrets.

# HTTP
PORT=3000
NODE_ENV=development

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nexus_user
MYSQL_PASSWORD=nexus_pass
MYSQL_DATABASE=nexusmarket

# MongoDB (audit trail)
MONGO_URI=mongodb://localhost:27017/audit_db

# Security
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_SALT_ROUNDS=10

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
